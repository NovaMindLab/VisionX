{
  "name": "smart-glass-debug-console",
  "version": "1.0.1",
  "description": "VisionX Smart Glass Debug Console for ESP32-S3",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vue": "vite",
    "build:vue": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.js --external:electron --external:serialport && esbuild electron/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.js --external:electron",
    "build": "npm run build:vue && npm run build:electron",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [
    "visionx",
    "smartglass",
    "esp32-s3",
    "electron"
  ],
  "author": "NovaMindLab",
  "license": "MIT",
  "dependencies": {
    "serialport": "^13.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.novamindlab.visionx.console",
    "productName": "VisionX-SmartGlass-Console",
    "directories": {
      "output": "release"
    },
    "afterPack": "./build/afterPack.js",
    "electronLanguages": [
      "zh-CN",
      "zh_CN",
      "en-US",
      "en"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
